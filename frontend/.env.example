# Copy to .env.local and fill in real values locally. Never commit the real file.

# Base URL of the Express API this frontend talks to. Must be NEXT_PUBLIC_-prefixed to be readable
# in browser-side code (Next.js only exposes prefixed vars to the client). Local/Docker: leave as
# the default backend port below. Live deployment: the Render backend URL, e.g.
# "https://dhaka-tesla-pool-mvp-1.onrender.com" — must also be present in the backend's own
# CORS_ORIGIN allowlist or requests will be blocked.
NEXT_PUBLIC_API_URL="http://localhost:4000"
