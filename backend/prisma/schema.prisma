// Prisma schema — MySQL provider, per MASTER_PLAN.md Section 1.
// Built incrementally, phase by phase, per MASTER_PLAN.md Section 8.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  PASSENGER
  DRIVER

  @@map("role")
}

enum TeslaStatus {
  ONLINE
  OFFLINE

  @@map("tesla_status")
}

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String   @map("password_hash")
  role         Role
  phone        String
  createdAt    DateTime @default(now()) @map("created_at")

  tesla                 Tesla?
  rideRequests          RideRequest[]
  rideStatusChangesMade RideStatusHistory[] @relation("ChangedByUser")

  @@map("users")
}

// teslas.driver_id is UNIQUE — one Tesla per driver (MVP assumption, docs/decisions.md item 3).
// teslas.capacity > 0 is enforced via a CHECK constraint added by hand to the migration SQL,
// since Prisma's schema language has no native @check attribute (docs/decisions.md item 10).
model Tesla {
  id        String      @id @default(uuid())
  driverId  String      @unique @map("driver_id")
  name      String
  capacity  Int
  status    TeslaStatus @default(OFFLINE)
  createdAt DateTime    @default(now()) @map("created_at")

  driver User   @relation(fields: [driverId], references: [id])
  pools  Pool[]

  @@map("teslas")
}

enum RideRequestStatus {
  REQUESTED
  MATCHED
  DRIVER_ARRIVED
  STARTED
  COMPLETED
  CANCELLED

  @@map("ride_request_status")
}

// zones.cluster is a flat, single-column grouping (docs/decisions.md item 5) — no zone_distance
// table; zone-to-zone distance is a hardcoded JS map instead (src/data/zones.js), per
// MASTER_PLAN.md Section 5's "JS constant map" option.
model Zone {
  id      String @id @default(uuid())
  name    String @unique
  cluster String

  pickupRequests      RideRequest[] @relation("PickupZone")
  destinationRequests RideRequest[] @relation("DestinationZone")

  @@map("zones")
}

// No pool_id column here — pool_memberships is the sole relationship to pools (Phase 4),
// per docs/erd.md. estimated_fare_paisa is set at creation (no discount); fare_paisa starts
// NULL and is finalized once, at pool MATCHED (docs/fare-model.md).
// idempotencyKey (MASTER_PLAN.md Section 13.1) — nullable+unique, a repeat POST /api/rides with
// the same key returns the original row instead of creating a duplicate.
// lateCancellation/cancellationFeePaisa (Section 6.2, grace-window cancellation) — computed and
// stored on cancel, never charged (no payment gateway in this MVP).
model RideRequest {
  id                   String            @id @default(uuid())
  passengerId          String            @map("passenger_id")
  pickupZoneId         String            @map("pickup_zone_id")
  destinationZoneId    String            @map("destination_zone_id")
  seatsRequested       Int               @map("seats_requested")
  status               RideRequestStatus @default(REQUESTED)
  estimatedFarePaisa   Int               @map("estimated_fare_paisa")
  farePaisa            Int?              @map("fare_paisa")
  idempotencyKey       String?           @unique @map("idempotency_key")
  lateCancellation     Boolean           @default(false) @map("late_cancellation")
  cancellationFeePaisa Int?              @map("cancellation_fee_paisa")
  requestedAt          DateTime          @default(now()) @map("requested_at")
  matchedAt            DateTime?         @map("matched_at")
  arrivedAt            DateTime?         @map("arrived_at")
  startedAt            DateTime?         @map("started_at")
  completedAt          DateTime?         @map("completed_at")
  cancelledAt          DateTime?         @map("cancelled_at")

  passenger       User @relation(fields: [passengerId], references: [id])
  pickupZone      Zone @relation("PickupZone", fields: [pickupZoneId], references: [id])
  destinationZone Zone @relation("DestinationZone", fields: [destinationZoneId], references: [id])

  poolMembership PoolMembership?
  statusHistory  RideStatusHistory[]

  @@map("ride_requests")
}

// One row per status transition, per docs/erd.md — written inside the same transaction as the
// transition itself (pool accept, lifecycle cascade, cancellation).
model RideStatusHistory {
  id            String   @id @default(uuid())
  rideRequestId String   @map("ride_request_id")
  fromStatus    String   @map("from_status")
  toStatus      String   @map("to_status")
  changedAt     DateTime @default(now()) @map("changed_at")
  changedBy     String   @map("changed_by")

  rideRequest   RideRequest @relation(fields: [rideRequestId], references: [id])
  changedByUser User        @relation("ChangedByUser", fields: [changedBy], references: [id])

  @@map("ride_status_history")
}

enum PoolStatus {
  OPEN
  MATCHED
  DRIVER_ARRIVED
  STARTED
  COMPLETED
  CANCELLED

  @@map("pool_status")
}

// No separate FULL status — "full" is computed (seats_occupied >= tesla.capacity), per
// docs/erd.md. One non-terminal (OPEN/MATCHED/DRIVER_ARRIVED/STARTED) pool per Tesla is an
// app-layer invariant, not a DB constraint — docs/decisions.md item 7.
model Pool {
  id            String     @id @default(uuid())
  teslaId       String     @map("tesla_id")
  status        PoolStatus @default(OPEN)
  seatsOccupied Int        @default(0) @map("seats_occupied")
  createdAt     DateTime   @default(now()) @map("created_at")
  matchedAt     DateTime?  @map("matched_at")
  completedAt   DateTime?  @map("completed_at")

  tesla       Tesla            @relation(fields: [teslaId], references: [id])
  memberships PoolMembership[]

  @@map("pools")
}

// pool_memberships is the ONLY relationship between pools and ride_requests — ride_requests has
// no pool_id column (docs/erd.md). ride_request_id is UNIQUE: one ride request can never be a
// member of two pools.
model PoolMembership {
  id            String   @id @default(uuid())
  poolId        String   @map("pool_id")
  rideRequestId String   @unique @map("ride_request_id")
  seats         Int
  createdAt     DateTime @default(now()) @map("created_at")

  pool        Pool        @relation(fields: [poolId], references: [id])
  rideRequest RideRequest @relation(fields: [rideRequestId], references: [id])

  @@map("pool_memberships")
}
