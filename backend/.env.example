# Copy to .env and fill in real values locally. Never commit the real .env file.

# MySQL connection string consumed by Prisma.
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE
# Local/Docker: the values below match docker-compose.yml's mysql service.
# Real deployment: this project uses a free Aiven MySQL instance — create one at aiven.io,
# then copy its "Service URI" from the Aiven console and swap in the DATABASE name at the end.
DATABASE_URL="mysql://root:password@localhost:3306/dhaka_tesla_pool"

# Port the Express API listens on. Free to change locally; hosting providers (e.g. Render) usually
# inject their own PORT env var and ignore this.
PORT=4000

# Secret used to sign/verify JWTs. Generate a long random one locally with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Never reuse the placeholder below outside local dev.
JWT_SECRET="replace-with-a-long-random-secret"

# Grace window (seconds) after a pool is MATCHED within which a passenger can cancel for free.
# Past this, the cancellation is flagged late_cancellation and a cancellation_fee_paisa is
# computed (not charged — no payment gateway in this MVP). MASTER_PLAN.md Section 6.2.
# No external value needed — pick any number of seconds.
GRACE_WINDOW_SECONDS=60

# Comma-separated CORS allowlist — the deployed frontend origin(s) + localhost in dev. Never "*"
# (MASTER_PLAN.md Section 13.5). For the live deployment this is the Vercel frontend URL, e.g.
# "https://dhaka-tesla-pool-mvp.vercel.app,http://localhost:3000".
CORS_ORIGIN="http://localhost:3000"
